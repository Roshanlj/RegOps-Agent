# ============================================================================
# RegOps Copilot - Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure with your actual values
# The system will load these variables on startup

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# Primary LLM Provider
# Specifies which provider to attempt first for all LLM requests
# Options: gemini, openrouter, ollama, local
# Default: gemini
LLM_PROVIDER=gemini

# Fallback Chain
# Comma-separated list of providers to try if primary fails
# Providers are attempted in order until one succeeds
# Default: gemini,openrouter,ollama
LLM_FALLBACK_CHAIN=gemini,openrouter,ollama

# ============================================================================
# GOOGLE GEMINI CONFIGURATION
# ============================================================================

# Gemini API Key (required for Gemini provider)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
# Options: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash-exp
# Default: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# ============================================================================
# OPENROUTER CONFIGURATION
# ============================================================================

# OpenRouter API Key (required for OpenRouter provider)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Selection
# Examples: anthropic/claude-3.5-sonnet, openai/gpt-4, meta-llama/llama-3.1-70b-instruct
# Default: anthropic/claude-3.5-sonnet
# See available models at: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ============================================================================
# OLLAMA CONFIGURATION (Local LLM)
# ============================================================================

# Ollama Base URL
# URL where Ollama server is running
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Model Name
# Must be a model you've already pulled with `ollama pull <model>`
# Examples: llama3.1:8b, mistral:7b, codellama:13b
# Default: llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# ============================================================================
# LOCAL LLM CONFIGURATION (OpenAI-compatible endpoints)
# ============================================================================

# Local LLM Base URL
# URL for OpenAI-compatible local LLM servers
# Examples:
#   - LM Studio: http://localhost:1234/v1
#   - llama.cpp server: http://localhost:8080/v1
#   - vLLM: http://localhost:8000/v1
# Leave empty to disable local provider
LOCAL_LLM_BASE_URL=

# Local LLM Model Name
# Model identifier to use in API requests
# Default: local
LOCAL_LLM_MODEL=local

# ============================================================================
# RETRY AND TIMEOUT CONFIGURATION
# ============================================================================

# Maximum Retry Attempts
# Number of times to retry a provider on rate limits or timeouts
# Each retry uses exponential backoff (2s, 4s, 8s)
# Default: 3
LLM_MAX_RETRIES=3

# Initial Retry Delay
# Starting delay in seconds before first retry
# Subsequent retries double this value (exponential backoff)
# Default: 2.0
LLM_RETRY_DELAY=2.0

# Request Timeout
# Maximum time in seconds to wait for LLM response
# Default: 60
LLM_TIMEOUT=60

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection URL
# Format: postgresql+psycopg2://user:password@host:port/database
# Used for vector embeddings with pgvector extension
# Docker default: postgresql+psycopg2://regops:regops@db:5432/regops
# Local default: postgresql+psycopg2://regops:regops@localhost:5432/regops
PG_URL=postgresql+psycopg2://regops:regops@localhost:5432/regops

# SQLite Database Path
# Path to local SQLite database for audit logs and document storage
# Default: data/copilot.sqlite3
COPILOT_DB=data/copilot.sqlite3

# Embeddings Mode
# Set to "1" to disable vector embeddings and use keyword search fallback
# Set to "0" to use pgvector for semantic search
# Default: 0
EMBEDDINGS_OFFLINE=0

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Example 1: Cloud-only setup (Gemini primary, OpenRouter fallback)
# LLM_PROVIDER=gemini
# LLM_FALLBACK_CHAIN=gemini,openrouter
# GEMINI_API_KEY=your_key_here
# OPENROUTER_API_KEY=your_key_here

# Example 2: Local-only setup (Ollama)
# LLM_PROVIDER=ollama
# LLM_FALLBACK_CHAIN=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Example 3: Hybrid setup (Cloud primary, local fallback)
# LLM_PROVIDER=gemini
# LLM_FALLBACK_CHAIN=gemini,ollama,local
# GEMINI_API_KEY=your_key_here
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# Example 4: Development without LLMs (deterministic fallback only)
# LLM_PROVIDER=none
# LLM_FALLBACK_CHAIN=
# (Leave all API keys and URLs empty)

# ============================================================================
# NOTES
# ============================================================================
# 
# - At least one provider should be configured for LLM functionality
# - If no providers are configured, system falls back to deterministic planning
# - Provider availability is checked on startup - unavailable providers are skipped
# - Rate limits trigger automatic retry with exponential backoff
# - After max retries, system tries next provider in fallback chain
# - All LLM requests are logged to audit table with provider name
# - Local providers (Ollama, Local LLM) require the service to be running
# - Cloud providers (Gemini, OpenRouter) require valid API keys and internet access
#
